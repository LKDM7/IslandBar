<Window x:Class="IslandBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IslandBar"
        Title="IslandBar" Width="460" Height="700" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="OnKey" Deactivated="OnDeactivated">
    <Window.Resources>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="Faint" Color="#59FFFFFF"/>
        <SolidColorBrush x:Key="Blurple" Color="#5865F2"/>
        <SolidColorBrush x:Key="QuietBlue" Color="#A5C8FF"/>
        <BooleanToVisibilityConverter x:Key="WhenTrue"/>

        <Style x:Key="Tick" TargetType="Rectangle">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Canvas.Top" Value="3"/>
        </Style>

        <Style x:Key="Bubble" TargetType="Border">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="6,1,6,2"/>
            <Setter Property="Canvas.Top" Value="-19"/>
        </Style>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Row" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="10,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Menu" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="8,2,8,4"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="SubMenu" TargetType="Border" BasedOn="{StaticResource Menu}">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="6,0,6,4"/>
        </Style>

        <!-- En-tête de sous-menu : Tag porte le choix en cours, IsChecked ouvre le sous-menu qui suit. -->
        <Style x:Key="Section" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="10,5">
                            <DockPanel>
                                <Path x:Name="Chevron" DockPanel.Dock="Right" Data="M6 9l6 6 6-6" Stroke="{StaticResource Dim}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="10" Margin="8,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform/>
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="150" FontSize="11.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChoiceRow">
            <Button Style="{StaticResource Row}" Click="ChoiceClick">
                <DockPanel>
                    <Path DockPanel.Dock="Right" Data="M4 12.5l5 5L20 6.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stretch="Uniform" Width="12" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding On, Converter={StaticResource WhenTrue}}"/>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="Bar" TargetType="Rectangle">
            <Setter Property="Width" Value="2.5"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="RadiusX" Value="1.25"/>
            <Setter Property="RadiusY" Value="1.25"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <DataTemplate x:Key="NoteRow">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36">
                    <Ellipse Fill="{StaticResource Blurple}"/>
                    <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Body}" Foreground="{StaticResource Dim}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Stamp}" MaxWidth="120" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Faint}" FontSize="11.5" VerticalAlignment="Top" Margin="0,3,0,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
            Width="96" Height="28" CornerRadius="14" Background="Black" Opacity="0"
            BorderBrush="#26FFFFFF" BorderThickness="0.5" MouseLeftButtonUp="PillClick" MouseRightButtonUp="PillRightClick"
            PreviewMouseLeftButtonDown="PillPress" MouseMove="PillDrag" LostMouseCapture="PillDropped"
            MouseEnter="PillHover" MouseLeave="PillHover">
        <Grid>
            <!-- Barre minimale -->
            <StackPanel x:Name="Compact" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,11,0">
                <Rectangle x:Name="MiniArt" Width="22" Height="22" RadiusX="6" RadiusY="6" Cursor="Hand" MouseLeftButtonUp="ArtClick"/>
                <TextBlock x:Name="MiniTitle" MaxWidth="180" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,11,0"/>
                <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Style="{StaticResource Bar}"/>
                    <Rectangle Style="{StaticResource Bar}"/>
                    <Rectangle Style="{StaticResource Bar}"/>
                    <Rectangle Style="{StaticResource Bar}"/>
                </StackPanel>
                <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Ellipse x:Name="CameraDot" Width="7" Height="7" Fill="#30D158" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="SensorText" MaxWidth="140" FontSize="11.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="7,0,0,0" Visibility="Collapsed"/>
                <Border x:Name="Badge" Background="{StaticResource Blurple}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Nouvelle notification -->
            <ContentControl x:Name="ToastView" ContentTemplate="{StaticResource NoteRow}" Width="380" Padding="0"
                            HorizontalContentAlignment="Stretch" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Focusable="False" Opacity="0" IsHitTestVisible="False">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <ContentPresenter Margin="16,0,22,0"/>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>

            <!-- Panneau ouvert avec le raccourci -->
            <StackPanel x:Name="Expanded" Width="420" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                <Grid Margin="18,18,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="BigArt" Width="64" Height="64" RadiusX="13" RadiusY="13" MouseLeftButtonUp="ArtClick"/>
                    <StackPanel Grid.Column="1" Margin="13,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TrackTitle" Text="{x:Static local:Strings.NothingPlaying}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackArtist" FontSize="13" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Icon}" Click="Prev" ToolTip="{x:Static local:Strings.Previous}">
                            <Path Fill="White" Data="M6 5.5h2.4v13H6zM20 5.5v13l-10-6.5z" Stretch="Uniform" Width="17"/>
                        </Button>
                        <Button Style="{StaticResource Icon}" Click="PlayPause" ToolTip="{x:Static local:Strings.PlayPause}">
                            <Path x:Name="PlayIcon" Fill="White" Data="M7 4.5v15l12.5-7.5z" Stretch="Uniform" Width="17" Height="19"/>
                        </Button>
                        <Button Style="{StaticResource Icon}" Click="Next" ToolTip="{x:Static local:Strings.Next}">
                            <Path Fill="White" Data="M4 5.5v13l10-6.5zM15.6 5.5H18v13h-2.4z" Stretch="Uniform" Width="17"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TimeRow" Margin="18,12,18,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeNow" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                    <Grid x:Name="ProgressTrack" Grid.Column="1" Height="18" Background="Transparent"
                          MouseLeftButtonDown="SeekDown" MouseMove="SeekDrag" MouseLeftButtonUp="SeekUp">
                        <Grid VerticalAlignment="Center" Height="4">
                            <Rectangle Fill="#33FFFFFF" RadiusX="2" RadiusY="2"/>
                            <Rectangle x:Name="ProgressFill" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Canvas x:Name="ProgressPreview" IsHitTestVisible="False" Visibility="{Binding IsMouseOver, ElementName=ProgressTrack, Converter={StaticResource WhenTrue}}">
                            <Rectangle Style="{StaticResource Tick}"/>
                            <Border Style="{StaticResource Bubble}">
                                <TextBlock FontSize="11"/>
                            </Border>
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="TimeEnd" Grid.Column="2" FontSize="11" Foreground="{StaticResource Dim}" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="VolumeRow" Margin="18,7,18,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <Path Fill="{StaticResource Dim}" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"
                          Stretch="Uniform" Width="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Grid x:Name="VolumeTrack" Grid.Column="1" Height="18" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="VolumeDown" MouseMove="VolumeDrag" MouseLeftButtonUp="VolumeUp">
                        <Grid VerticalAlignment="Center" Height="6">
                            <Rectangle Fill="#33FFFFFF" RadiusX="3" RadiusY="3"/>
                            <Rectangle Fill="White" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="VolumeScale" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Canvas x:Name="VolumePreview" IsHitTestVisible="False" Visibility="{Binding IsMouseOver, ElementName=VolumeTrack, Converter={StaticResource WhenTrue}}">
                            <Rectangle Style="{StaticResource Tick}"/>
                            <Border Style="{StaticResource Bubble}">
                                <TextBlock FontSize="11"/>
                            </Border>
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="11" Foreground="{StaticResource Dim}" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="OutputRow" Style="{StaticResource Row}" Margin="8,3,8,0" Visibility="Collapsed" Click="OutputClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Fill="{StaticResource Dim}" Data="M12 3a9 9 0 0 0-9 9v7a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H5v-2a7 7 0 0 1 14 0v2h-1a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-7a9 9 0 0 0-9-9z"
                              Stretch="Uniform" Width="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OutputText" Grid.Column="1" FontSize="11.5" Foreground="#A8E6B4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Path Grid.Column="2" Data="M6 9l6 6 6-6" Stroke="{StaticResource Dim}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" Width="10" Margin="8,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="OutputChevron"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>

                <Border x:Name="OutputMenu" Style="{StaticResource Menu}">
                    <ScrollViewer MaxHeight="224" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ItemsControl x:Name="OutputList" ItemTemplate="{StaticResource ChoiceRow}" Focusable="False"/>
                    </ScrollViewer>
                </Border>

                <Rectangle Height="0.5" Fill="#2EFFFFFF" Margin="18,12,18,0"/>

                <DockPanel Margin="18,9,12,3">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="GearClick" Width="26" Height="26" ToolTip="{x:Static local:Strings.Settings}">
                        <Path Fill="{StaticResource Dim}" Stretch="Uniform" Width="15"
                              Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="ClearNotes" Padding="10,3" Foreground="{StaticResource Dim}" Content="{x:Static local:Strings.Clear}"/>
                    <TextBlock x:Name="NotesHeader" Text="{x:Static local:Strings.Notifications}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                </DockPanel>

                <Border x:Name="SettingsMenu" Style="{StaticResource Menu}">
                    <StackPanel>
                        <ContentControl x:Name="QuietRow" ContentTemplate="{StaticResource ChoiceRow}" Focusable="False"/>
                        <StackPanel x:Name="ScreenChoice" Visibility="Collapsed">
                            <ToggleButton x:Name="ScreenHeader" Style="{StaticResource Section}" Content="{x:Static local:Strings.ScreenLabel}" Click="SectionClick"/>
                            <Border Style="{StaticResource SubMenu}" Visibility="{Binding IsChecked, ElementName=ScreenHeader, Converter={StaticResource WhenTrue}}">
                                <ItemsControl x:Name="ScreenList" ItemTemplate="{StaticResource ChoiceRow}" Focusable="False"/>
                            </Border>
                        </StackPanel>
                        <ToggleButton x:Name="AppsHeader" Style="{StaticResource Section}" Click="SectionClick"/>
                        <Border Style="{StaticResource SubMenu}" Visibility="{Binding IsChecked, ElementName=AppsHeader, Converter={StaticResource WhenTrue}}">
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                <ItemsControl x:Name="AppList" ItemTemplate="{StaticResource ChoiceRow}" Focusable="False"/>
                            </ScrollViewer>
                        </Border>
                        <Rectangle Height="0.5" Fill="#2EFFFFFF" Margin="10,4"/>
                        <Button Style="{StaticResource Row}" Click="Quit" Content="{x:Static local:Strings.Quit}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Empty" Text="{x:Static local:Strings.NoNotifications}" FontSize="13" Foreground="{StaticResource Faint}" Margin="18,6,18,8" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="184" VerticalScrollBarVisibility="Hidden" Margin="18,0" Focusable="False">
                    <ItemsControl x:Name="NoteList" ItemTemplate="{StaticResource NoteRow}" Cursor="Hand" MouseLeftButtonUp="NoteClick" Focusable="False"/>
                </ScrollViewer>

                <TextBlock Text="{x:Static local:Strings.Help}"
                           FontSize="10.5" Foreground="{StaticResource Faint}" TextAlignment="Center" Margin="12,9,12,14"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
